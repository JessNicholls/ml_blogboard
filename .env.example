# ── Orchestrator ─────────────────────────────────────────────────────────────
# Set to "wxorchestrate" to use IBM Watsonx Orchestrate instead of LangGraph.
# Leave unset (or "langgraph") to use the default LangGraph pipeline.
ORCHESTRATOR=langgraph

# ── IBM Watsonx Orchestrate (only required when ORCHESTRATOR=wxorchestrate) ──
# Your IBM Cloud API key (same key used for watsonx.ai if already set).
watsonx_orchestrate__api_key=""
# The base URL of your Watsonx Orchestrate instance.
watsonx_orchestrate__instance_url=""
# Optional: deployment space ID for the Orchestrate platform.
watsonx_orchestrate__space_id=""

# ── IBM Watsonx.ai LLM backend (only required when llm__provider=watsonx) ────
watsonx__api_key=""
watsonx__project_id=""
watsonx__url="https://eu-gb.ml.cloud.ibm.com"
watsonx__model_name="meta-llama/llama-3-3-70b-instruct"


# LLM Settings
llm__api_key=""

# Cloudflare R2 Settings
r2__account_id=""
r2__access_key_id=""
r2__secret_access_key=""
r2__bucket_name=""

# Content API Settings
content__tavily_api_key=""
content__guardian_api_key=""
content__unsplash_api_key=""

# Opik Settings
OPIK_API_KEY=""
OPIK_PROJECT_NAME="blogboard"

# Error Tracking
SENTRY_DSN=""